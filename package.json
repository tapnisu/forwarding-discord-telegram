{
  "name": "forwarding-discord-telegram",
  "version": "2.5.0",
  "description": "Selfbot that forwards your Discord messages to Telegram",
  "main": "dist/index.js",
  "scripts": {
    "start": "node .",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "format": "prettier . --check --ignore-path .gitignore",
    "format:fix": "prettier . --write --ignore-path .gitignore",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "keywords": [
    "bot",
    "discord",
    "self-bot"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tapnisu/forwarding-discord-telegram.git"
  },
  "author": {
    "email": "aleksei@tapni.su",
    "name": "Aleksei Rybin",
    "url": "https://tapni.su"
  },
  "dependencies": {
    "@grammyjs/auto-retry": "^2.0.2",
    "discord-webhook-node": "^1.1.8",
    "discord.js": "^14.27.0",
    "discord.js-selfbot-v13": "^3.7.1",
    "dotenv": "^16.6.1",
    "grammy": "^1.46.0",
    "prettier": "^3.9.8",
    "proxy-agent": "^6.5.0"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.4",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.12.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.70.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.27.1+sha512.a81d4c21b9b09a4b0aebf90ef5e527d4262bdda322d26082978cb549023ac6d9cafc98b19fffaa5c71db438a65f70224edb78d7311187861ff96480d1cdca23c"
